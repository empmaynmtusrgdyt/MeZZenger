QWidget, QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}

QListWidget {
    background-color: #3c3c3c;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 5px;
    outline: none;
}

QListWidget::item {
    padding: 12px;
    border-radius: 4px;
    margin: 2px 0;
    color: #ffffff;
}

QListWidget::item:selected {
    background-color: #4caf50;
    color: #ffffff;
}

QListWidget::item:hover:!selected {
    background-color: #444444;
}

QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 10px;
    color: #ffffff;
    selection-background-color: #4caf50;
}

QLineEdit:focus {
    border: 1px solid #4caf50;
}

QLineEdit:disabled {
    background-color: #333333;
    color: #888888;
}

QTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 10px;
    color: #ffffff;
    selection-background-color: #4caf50;
}

QTextEdit:disabled {
    background-color: #252525;
}

QPushButton {
    background-color: #4caf50;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #45a049;
}

QPushButton:pressed {
    background-color: #3d8b40;
}

QPushButton:disabled {
    background-color: #555555;
    color: #888888;
}

QScrollBar:vertical {
    background-color: #2b2b2b;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #4caf50;
}

QLabel#chatTitleLabel {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#statusLabel {
    color: #888888;
    font-size: 12px;
}

QMessageBox {
    background-color: #2b2b2b;
}

QMessageBox QLabel {
    color: #ffffff;
}

QMessageBox QPushButton {
    min-width: 80px;
}

QTabWidget::pane {
    border: 1px solid #444444;
    border-radius: 6px;
    background-color: #3c3c3c;
}

QTabBar::tab {
    background-color: #333333;
    border: 1px solid #444444;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 10px 20px;
    color: #888888;
}

QTabBar::tab:selected {
    background-color: #4caf50;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #444444;
}

QMenu {
    background-color: #3c3c3c;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #4caf50;
}

QListWidget QScrollBar {
    width: 8px;
    background: #2b2b2b;
}

QListWidget QScrollBar::handle {
    background: #555555;
    border-radius: 4px;
}

QListWidget QScrollBar::handle:hover {
    background: #666666;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #444444;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #4caf50;
}
